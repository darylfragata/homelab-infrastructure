#!/bin/bash
set -e  # Exit immediately if a command exits with a non-zero status

# Own log file; invoked on demand via aws ssm send-command, safe to re-run.
# fd 3 keeps a copy of the real stdout (what SSM captures) before it's
# redirected to the log file - use it for anything that should show up in
# the SSM output, not just the log.
exec 3>&1
exec > /var/log/configure-agent.log 2>&1

# Fail fast if the data volume isn't mounted yet, instead of installing onto
# the root disk or failing later with a confusing error.
if ! mountpoint -q /mnt/ado-data; then
  echo "ERROR: /mnt/ado-data is not mounted. Run the mount_data_volume SSM document first (it formats/mounts the data volume), then re-run this document." | tee /dev/fd/3 >&2
  exit 1
fi

# ---- Azure Pipelines agent (unattended registration) ----
# url/pool/agent_name are baked in at plan time via templatefile() - only the
# PAT is fetched at runtime, as a raw string, from SSM Parameter Store.
AZP_URL="${azp_url}"
AZP_POOL="${azp_pool}"
AZP_AGENT_NAME="${azp_agent_name}"
AZP_PAT_PARAM="${ado_pat_parameter_name}"
AZP_USER="ubuntu"
AZP_AGENT_DIR="/home/$AZP_USER/azagent"
AWS_REGION="${aws_region}"

# Decrypted via the instance's IAM role - never embedded in this script or visible in plaintext
# EC2 metadata/console output.
AZP_TOKEN=$(aws ssm get-parameter --name "$AZP_PAT_PARAM" --with-decryption --region "$AWS_REGION" --query "Parameter.Value" --output text)

AZP_AGENT_VERSION=$(curl -fsS https://api.github.com/repos/microsoft/azure-pipelines-agent/releases/latest | jq -r '.tag_name' | sed 's/^v//')
mkdir -p "$AZP_AGENT_DIR"
curl -fsSL "https://download.agent.dev.azure.com/agent/$AZP_AGENT_VERSION/vsts-agent-linux-x64-$AZP_AGENT_VERSION.tar.gz" -o /tmp/vsts-agent.tar.gz
tar zxvf /tmp/vsts-agent.tar.gz -C "$AZP_AGENT_DIR"
chown -R "$AZP_USER:$AZP_USER" "$AZP_AGENT_DIR"

# The agent must not be configured/run as root - run config.sh as the ubuntu user.
# --replace is already safe to re-run: it de-registers any existing agent identity
# with the same name and re-registers fresh, overwriting local credentials in place.
sudo -u "$AZP_USER" -H bash -c "cd '$AZP_AGENT_DIR' && ./config.sh --unattended \
  --url '$AZP_URL' \
  --auth pat \
  --token '$AZP_TOKEN' \
  --pool '$AZP_POOL' \
  --agent '$AZP_AGENT_NAME' \
  --acceptTeeEula \
  --replace"

# Install and start as a systemd service so it survives reboots. svc.sh install
# refuses to reinstall over an existing unit, so this script is safe to re-run
# against an already-configured agent (PAT rotation, pool change, etc) by
# uninstalling any prior service first.
cd "$AZP_AGENT_DIR"
if [ -f "$AZP_AGENT_DIR/.service" ]; then
  echo "Existing service registration found - stopping and uninstalling before reconfiguring."
  ./svc.sh stop || true
  ./svc.sh uninstall || true
fi
./svc.sh install "$AZP_USER"
./svc.sh start

# ---- Summary ----
# Reaching here means everything above succeeded (set -e). Written to fd 3
# so it shows up in the SSM output, not just the log.
{
  echo "===== configure-agent.sh: SUCCESS ====="
  echo "ADO agent '$AZP_AGENT_NAME' registered in pool '$AZP_POOL' at $AZP_URL"
  echo "Azure Pipelines agent version: $AZP_AGENT_VERSION"
  echo "--- Tool versions on this instance ---"
  echo "terraform: $(terraform --version | head -n1)"
  echo "python3:   $(python3 --version)"
  echo "awscli:    $(aws --version)"
  echo "git:       $(git --version)"
} | tee /dev/fd/3
